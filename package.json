{
  "name": "boids-in-the-blue",
  "version": "1.2.0",
  "private": true,
  "description": "Dev tooling only (no dependencies). The plugin itself is pure QML + JS.",
  "scripts": {
    "build": "node tools/build.js",
    "build:check": "node tools/build.js --check",
    "test": "node tools/build.js --check && node --test tests/",
    "bench": "node tests/bench.js",
    "golden:qml": "node tests/qml-golden.js",
    "golden:gen": "node tools/gen-golden.js",
    "test:qml": "node tests/qml-golden.js && node tests/qml-render.js compare && node tests/qml-render.js smoke && node tests/qml-switch.js && node tests/qml-config.js",
    "render:compare": "node tests/qml-render.js compare",
    "render:smoke": "node tests/qml-render.js smoke",
    "render:previews": "node tests/qml-render.js previews",
    "gen:previews": "node tools/gen-previews.js",
    "flock": "node tests/flock-eval.js",
    "test:config": "node tests/qml-config.js",
    "test:switch": "node tests/qml-switch.js && node tests/qml-config.js"
  }
}
